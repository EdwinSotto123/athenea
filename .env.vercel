# ═══════════════════════════════════════════════════════════════
# VERCEL ENVIRONMENT VARIABLES - REFERENCIA
# ═══════════════════════════════════════════════════════════════
# 
# ESTAS VARIABLES VAN EN VERCEL DASHBOARD (Settings → Environment Variables)
# NO en tu código, NO en .env.local
#
# ═══════════════════════════════════════════════════════════════

# Gemini AI - Para chat con IA y análisis de evidencias
GEMINI_API_KEY=tu-gemini-api-key-aqui

# Pinata IPFS - Para subir evidencias de forma permanente
PINATA_JWT=tu-pinata-jwt-aqui

# IQAI ATP - Para enviar logs al dashboard del agente
IQAI_API_KEY=tu-iqai-api-key-aqui

# Wallet Encryption - Para cifrar las wallets custodiales
WALLET_SECRET=tu-clave-de-cifrado-segura-aqui

# ═══════════════════════════════════════════════════════════════
# CÓMO AGREGAR EN VERCEL:
# ═══════════════════════════════════════════════════════════════
#
# 1. Ve a: https://vercel.com/tu-proyecto/settings/environment-variables
# 2. Agrega cada variable con su valor
# 3. Selecciona "Production", "Preview", y "Development"
# 4. Click "Save"
#
# ═══════════════════════════════════════════════════════════════
# IMPORTANTE:
# ═══════════════════════════════════════════════════════════════
#
# - SIN prefijo VITE_ (eso las haría públicas)
# - Solo accesibles desde API Routes (backend)
# - El frontend NO puede leerlas directamente
#
# ═══════════════════════════════════════════════════════════════
